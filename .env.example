# === XKSH808 ULTIMATE MCP — Environment Variables ===

# Hugging Face
HF_TOKEN=hf_your_token_here

# Stripe (payments)
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Tier tokens (generate random UUIDs for each paying user)
# Format: USER_TOKEN_<tier> — stored in your CRM / Notion DB
# OWNER_TOKEN is Xavier's master key (free, unlimited)
OWNER_TOKEN=your_secret_owner_token_here

# Make.com webhook URL (outbound automation trigger)
MAKE_WEBHOOK_URL=https://hook.us1.make.com/your_webhook_id

# Notion (optional — for CRM sync)
NOTION_API_TOKEN=secret_your_notion_token

# Telegram (optional — for ritual triggers)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Server
PORT=8000
MCP_SERVER_HOST=0.0.0.0
